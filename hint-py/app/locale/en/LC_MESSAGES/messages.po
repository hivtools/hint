#. Placeholders: {app_title}, {code} (to quote to support), {support_email}.
msgid "unexpectedError"
msgstr ""
"An unexpected error occurred. If you see this message while you are using {app_title} at a workshop, please contact "
"your workshop technical support and show them this code: {code}. Otherwise please contact support at {support_email} "
"and quote this code: {code}."

msgid "loadFailed"
msgstr "Unable to load files for session. Specified files do not exist on the server."

msgid "userExists"
msgstr "User already exists."

msgid "invalidEmail"
msgstr "Please provide a valid email address."

msgid "projectDoesNotExist"
msgstr "Project does not exist."

msgid "versionDoesNotExist"
msgstr "Version does not exist."

msgid "invalidVersion"
msgstr "The version cannot be used by this user."

msgid "guestsOnly"
msgstr "Only guests can create a guest version."

msgid "userDoesNotExist"
msgstr "User does not exist."

msgid "missingShapeFile"
msgstr "You must upload a shape file before uploading survey or programme data."

#. Placeholders: {max_size} (such as "200 MB").
msgid "fileTooLarge"
msgstr "The file is too large. Files can be up to {max_size}."

#. Placeholders: {expected} (such as "PJNZ, zip"), {got}.
msgid "invalidFileExtension"
msgstr "File must be of type {expected}, got type {got}."

msgid "invalidToken"
msgstr "Token is not valid."

msgid "invalidPasswordLength"
msgstr "Password must be at least 6 characters long."

msgid "unknownInputTimeSeriesType"
msgstr "Unknown input time series type."

msgid "noPermissionToAccessResource"
msgstr "You do not have permission to load this resource from ADR. Contact dataset admin for permission."

#. Placeholders: {resource}.
msgid "adrResourceError"
msgstr "Unable to load resource, check resource in ADR {resource}."

#. Placeholders: {resource} (the link that the user gave).
msgid "notOnAdr"
msgstr "This link does not lead to ADR, so the file cannot be imported: {resource}"

msgid "invalidResourceType"
msgstr "Invalid resourceType"

msgid "descriptionRequired"
msgstr "description must be provided for output resourceType"

msgid "resourceIdRequired"
msgstr "resourceId must be provided for input resourceType"

msgid "fileDoesNotExist"
msgstr "File does not exist"

msgid "adrHashUnavailable"
msgstr "Unable to retrieve hash from ADR"

msgid "adrFetchingDatasetsError"
msgstr "There was an error fetching datasets from ADR."

msgid "adrFetchingDatasetsNoAccountError"
msgstr ""
"Cannot fetch datasets from the ADR as you do not yet have an account. Please login to the ADR with your Auth0 "
"credentials and then return here and try again."

msgid "unknownReviewInputFileType"
msgstr "Unknown review input plot file type."

msgid "missingCalibrateData"
msgstr "No calibration output found for this project, please report an issue or re-calibrate the model"

msgid "failedZipRehydrate"
msgstr "Cannot load model outputs. This fit was not generated on the Naomi web application. Please contact support."

msgid "rehydrateMissingInputFile"
msgstr "Unable to load output zip, input files not found. Please contact a system admin."

msgid "rehydrateModelFitIdUnknown"
msgstr "Unable to load output zip, model fit not generated on the web app. Please contact a system admin."

msgid "rehydrateCalibrateIdUnknown"
msgstr "Unable to load output zip, model calibrate not generated on the web app. Please contact a system admin."

msgid "noADRKey"
msgstr ""
"Could not find your ADR credentials. Please log out and log in again with your single sign-on account."

msgid "noResponse"
msgstr "No response returned. The request may have timed out."

msgid "unparseableResponse"
msgstr "Could not parse response."

msgid "adrTimeout"
msgstr "ADR request timed out"

msgid "adrBadGateway"
msgstr "Failed to get response from ADR, try again later."

msgid "githubTokenRequired"
msgstr "A GitHub token is needed. Send it in the Authorization header as \"Bearer <token>\"."

msgid "githubTokenInvalid"
msgstr "GitHub did not accept the token. Check that it is correct and has not expired."

msgid "notInGitHubTeam"
msgstr ""
"You may not download this. Your GitHub user must be a member of the team that may download debug files, and the "
"token must be able to read the team (a classic token needs the read:org scope)."

msgid "githubFailed"
msgstr "Could not check the GitHub token, because GitHub did not answer as expected. Try again later."

msgid "auth0StateMissing"
msgstr "Auth0 state parameter must be provided"

msgid "auth0StateMismatch"
msgstr "Auth0 State parameter mismatch possible threat of cross-site request forgery"

# New in hint-py.
msgid "auth0CodeMissing"
msgstr "Auth0 did not send a login code. Please try to log in again."


msgid "adrLoginExpired"
msgstr "Your login to ADR has expired. Please log in again."
