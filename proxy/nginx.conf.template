# Front door for hint. Everything goes to the Python API (hint-py). The Kotlin app is no longer routed: its code is
# still in src/app until it is deleted, and `scripts/dev.sh up --no-proxy` runs it alone, for comparison.
#
# PYTHON_UPSTREAM (host:port) is substituted from the environment on container start by the nginx image's envsubst
# templating.

# Trust X-Forwarded-Proto from an upstream TLS terminator, else use our own scheme.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

upstream python {
    server ${PYTHON_UPSTREAM};
}

server {
    listen 80;

    # Uploads can be large and are streamed straight through to the backend.
    client_max_body_size 0;
    proxy_request_buffering off;

    # Model/ADR calls can be slow.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # The Vue app: its page (for each of its routes) and the built files. These never read a session, so the cookie is
    # not sent (see snippets/python-public.conf)
    location = / { include snippets/python-public.conf; }
    location = /projects { include snippets/python-public.conf; }
    location = /accessibility { include snippets/python-public.conf; }
    location = /privacy { include snippets/python-public.conf; }
    location /public/ { include snippets/python-public.conf; }

    # The debug zip of a model run, for developers. The caller sends a GitHub token and no hint login, so the session
    # cookie is not sent (see snippets/python-github.conf)
    location ~ ^/model/debug/[^/]+$ { include snippets/python-github.conf; }

    # Everything else, with the session cookie
    location / { include snippets/python.conf; }
}
