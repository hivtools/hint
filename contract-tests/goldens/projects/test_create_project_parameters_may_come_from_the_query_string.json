{
  "scenario": "projects/test_create_project_parameters_may_come_from_the_query_string",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "name in query string",
      "request": {
        "method": "POST",
        "path": "/project/",
        "query": {
          "name": "from query"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "id": "<PROJECT:1>",
              "name": "from query",
              "note": null,
              "sharedBy": "",
              "uploaded": null,
              "versions": [
                {
                  "created": "<TIMESTAMP>",
                  "id": "<UUID:1>",
                  "note": null,
                  "updated": "<TIMESTAMP>",
                  "versionNumber": 1
                }
              ]
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    }
  ]
}
