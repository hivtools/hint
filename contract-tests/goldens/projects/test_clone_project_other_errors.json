        },
        "status": 200
      }
    },
    {
      "client": "B",
      "name": "login naomi-support@imperial.ac.uk",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "naomi-support@imperial.ac.uk"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "B",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "create project mine",
      "request": {
        "body": {
          "form": {
            "name": "mine",
            "note": "a note"
          }
        },
        "method": "POST",
        "path": "/project/"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "id": "<PROJECT:1>",
              "name": "mine",
              "note": null,
              "sharedBy": "",
              "uploaded": null,
              "versions": [
                {
                  "created": "<TIMESTAMP>",
                  "id": "<UUID:1>",
                  "note": null,
                  "updated": "<TIMESTAMP>",
                  "versionNumber": 1
                }
              ]
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "no emails parameter",
      "request": {
        "method": "POST",
        "path": "/project/<PROJECT:1>/clone"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "An unexpected error occurred. If you see this message while you are using Naomi at a workshop, please contact your workshop technical support and show them this code: <ERROR_CODE>. Otherwise please contact support at naomi-support@imperial.ac.uk and quote this code: <ERROR_CODE>. Required request parameter 'emails' for method parameter type List is not present",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "email without @",
      "request": {
        "body": {
          "form": {
            "emails": "not-an-email"
          }
        },
        "method": "POST",
        "path": "/project/<PROJECT:1>/clone"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Please provide a valid email address.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "unknown project",
      "request": {
        "body": {
          "form": {
            "emails": "naomi-support@imperial.ac.uk"
          }
        },
        "method": "POST",
        "path": "/project/999/clone"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Project does not exist.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "B",
      "name": "cloning someone else's project",
      "request": {
        "body": {
          "form": {
            "emails": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/project/<PROJECT:1>/clone"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Project does not exist.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "empty emails",
      "request": {
        "body": {
          "form": {
            "emails": ""
          }
        },
        "method": "POST",
        "path": "/project/<PROJECT:1>/clone"
      },
      "response": {
        "body": {
          "json": {
            "data": null,
            "errors": [],
