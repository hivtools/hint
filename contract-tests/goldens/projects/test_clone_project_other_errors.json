          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "name": "db:project",
      "rows": [
        {
          "id": "<PROJECT:1>",
          "is_uploaded": null,
          "name": "mine",
          "note": "a note",
          "shared_by": null,
          "user_id": "test.user@example.com"
        }
      ],
      "table": "project",
      "type": "db"
    }
  ]
