{
  "scenario": "projects/test_create_project_without_note_and_is_uploaded_variants",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "create project no note",
      "request": {
        "body": {
          "json": {
            "name": "no note"
          }
        },
        "method": "POST",
        "path": "/project"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "id": "<PROJECT:1>",
              "name": "no note",
              "note": null,
              "sharedBy": "",
              "uploaded": null,
              "versions": [
                {
                  "created": "<TIMESTAMP>",
                  "id": "<UUID:1>",
                  "note": null,
                  "updated": "<TIMESTAMP>",
                  "versionNumber": 1
                }
              ]
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "isUploaded=true",
      "request": {
        "body": {
          "json": {
            "isUploaded": true,
            "name": "uploaded",
            "note": "n"
          }
        },
        "method": "POST",
        "path": "/project"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "id": "<PROJECT:2>",
              "name": "uploaded",
              "note": null,
              "sharedBy": "",
              "uploaded": true,
              "versions": [
                {
                  "created": "<TIMESTAMP>",
                  "id": "<UUID:2>",
                  "note": null,
                  "updated": "<TIMESTAMP>",
                  "versionNumber": 1
                }
              ]
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "isUploaded=false",
      "request": {
        "body": {
          "json": {
            "isUploaded": false,
            "name": "not uploaded"
          }
        },
        "method": "POST",
        "path": "/project"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "id": "<PROJECT:3>",
              "name": "not uploaded",
              "note": null,
              "sharedBy": "",
              "uploaded": false,
              "versions": [
                {
                  "created": "<TIMESTAMP>",
                  "id": "<UUID:3>",
                  "note": null,
                  "updated": "<TIMESTAMP>",
                  "versionNumber": 1
                }
              ]
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "list shows isUploaded as 'uploaded'",
      "request": {
        "method": "GET",
        "path": "/projects/"
      },
      "response": {
        "body": {
          "json": {
            "data": [
              {
                "id": "<PROJECT:3>",
                "name": "not uploaded",
                "note": null,
                "sharedBy": null,
                "uploaded": false,
                "versions": [
                  {
                    "created": "<TIMESTAMP>",
                    "id": "<UUID:3>",
                    "note": null,
                    "updated": "<TIMESTAMP>",
                    "versionNumber": 1
                  }
                ]
              },
              {
                "id": "<PROJECT:2>",
                "name": "uploaded",
                "note": "n",
                "sharedBy": null,
                "uploaded": true,
                "versions": [
                  {
                    "created": "<TIMESTAMP>",
                    "id": "<UUID:2>",
                    "note": null,
                    "updated": "<TIMESTAMP>",
                    "versionNumber": 1
                  }
                ]
              },
              {
                "id": "<PROJECT:1>",
                "name": "no note",
                "note": null,
                "sharedBy": null,
                "uploaded": null,
                "versions": [
                  {
                    "created": "<TIMESTAMP>",
                    "id": "<UUID:1>",
                    "note": null,
                    "updated": "<TIMESTAMP>",
                    "versionNumber": 1
                  }
                ]
              }
            ],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "name": "db:project",
      "rows": [
        {
          "id": "<PROJECT:1>",
          "is_uploaded": null,
          "name": "no note",
          "note": null,
          "shared_by": null,
          "user_id": "test.user@example.com"
        },
        {
          "id": "<PROJECT:2>",
          "is_uploaded": true,
          "name": "uploaded",
          "note": "n",
          "shared_by": null,
          "user_id": "test.user@example.com"
        },
        {
          "id": "<PROJECT:3>",
          "is_uploaded": false,
          "name": "not uploaded",
          "note": null,
          "shared_by": null,
          "user_id": "test.user@example.com"
        }
      ],
      "table": "project",
      "type": "db"
    }
  ]
}
