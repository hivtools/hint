      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/task/<TASK:fit>/exists",
          "status": 200,
          "to": "hintr"
        },
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/task/<TASK:calibrate>/exists",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "body": {
          "multipart": {
