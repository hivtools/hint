              "sha256": "08ca7285af98b98b1d237b9cf776bd4dd8d3bd3630a23751db46097e50f6a20e",
              "size": 860
            }
          }
        },
        "method": "POST",
        "path": "/rehydrate/zip"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Cannot load model outputs. This fit was not generated on the Naomi web application. Please contact support.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
