{
  "scenario": "rehydrate/test_rehydrate_does_not_touch_the_session",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "upload pjnz",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "json": {
            "file": {
              "filename": "Malawi2024.PJNZ",
              "fromADR": false,
              "hash": "46E4A725064B0E287F573A8F11389895.PJNZ",
              "path": "<UPLOADS>/46E4A725064B0E287F573A8F11389895.PJNZ",
              "resource_url": null
            },
            "type": "pjnz"
          },
          "method": "POST",
          "path": "/validate/baseline-individual",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "body": {
          "multipart": {
            "file": {
              "filename": "Malawi2024.PJNZ",
              "fixture": "Malawi2024.PJNZ",
              "sha256": "49d688e8fe81c4d4dd49a081791e756bcdbbd1542587812bceea354bda02d3c1",
              "size": 1721376
            }
          }
        },
        "method": "POST",
        "path": "/baseline/pjnz/"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "upload shape",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "json": {
            "file": {
              "filename": "malawi.geojson",
              "fromADR": false,
              "hash": "EBE533976BFAF0CABCA2C2E1B611B9C7.geojson",
              "path": "<UPLOADS>/EBE533976BFAF0CABCA2C2E1B611B9C7.geojson",
              "resource_url": null
            },
            "type": "shape"
          },
          "method": "POST",
          "path": "/validate/baseline-individual",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "body": {
          "multipart": {
            "file": {
              "filename": "malawi.geojson",
              "fixture": "malawi.geojson",
              "sha256": "fb9a189da2337c0b568998b3ab668ebf9e433e6ec26135cae95c20bf9bd5a953",
              "size": 1045993
            }
          }
        },
        "method": "POST",
        "path": "/baseline/shape/"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "valid zip",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/task/<TASK:fit>/exists",
          "status": 200,
          "to": "hintr"
        },
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/task/<TASK:calibrate>/exists",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "body": {
          "multipart": {
            "file": {
              "filename": "output.zip",
              "volatile_content": true
            }
          }
        },
        "method": "POST",
        "path": "/rehydrate/zip"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "notes": "project notes\nline 2",
              "state": {
                "calibrate": {
                  "id": "<TASK:calibrate>",
                  "options": {}
                },
                "datasets": {
                  "pjnz": {
                    "filename": "Malawi2024.PJNZ",
                    "hash": "46E4A725064B0E287F573A8F11389895.PJNZ",
                    "path": "<UPLOADS>/46E4A725064B0E287F573A8F11389895.PJNZ"
                  },
                  "shape": {
                    "filename": "malawi.geojson",
                    "hash": "EBE533976BFAF0CABCA2C2E1B611B9C7.geojson",
                    "path": "<UPLOADS>/EBE533976BFAF0CABCA2C2E1B611B9C7.geojson"
                  }
                },
                "model_fit": {
                  "id": "<TASK:fit>",
                  "options": {}
                },
                "version": {
                  "hintr": "1.2.23",
                  "naomi": "2.10.23",
                  "rrq": "0.7.23",
                  "traduire": "0.1.1"
                }
              }
            },
            "errors": null,
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "name": "db:project",
      "rows": [],
      "table": "project",
      "type": "db"
    },
    {
      "client": "A",
      "name": "no project created by rehydrate itself",
      "request": {
        "method": "GET",
        "path": "/projects/"
      },
      "response": {
        "body": {
          "json": {
            "data": [],
            "errors": [],
