{
  "scenario": "misc_edges/test_user_exists_special_characters",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "percent-encoded @",
      "request": {
        "method": "GET",
        "path": "/user/test.user%40example.com/exists"
      },
      "response": {
        "body": {
          "json": {
            "data": true,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "space in local part",
      "request": {
        "method": "GET",
        "path": "/user/a%20b@example.com/exists"
      },
      "response": {
        "body": {
          "json": {
            "data": false,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "trailing newline",
      "request": {
        "method": "GET",
        "path": "/user/test.user@example.com%0A/exists"
      },
      "response": {
        "body": {
          "json": {
            "data": false,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "dots",
      "request": {
        "method": "GET",
        "path": "/user/%2e%2e/exists"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Please provide a valid email address.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    }
  ]
}
