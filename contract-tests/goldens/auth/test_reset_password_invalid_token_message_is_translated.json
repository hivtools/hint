{
  "scenario": "auth/test_reset_password_invalid_token_message_is_translated",
  "steps": [
    {
      "client": "A",
      "name": "invalid token in fr",
      "request": {
        "body": {
          "form": {
            "password": "newpassword",
            "token": "blah"
          }
        },
        "headers": {
          "accept-language": "fr"
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Le jeton n'est pas valide.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "short password in fr",
