{
  "scenario": "auth/test_second_login_replaces_first_user_in_same_session",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "user 1",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "contains": [
            "currentUser = \"test.user@example.com\""
          ],
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "login as second user",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "naomi-support@imperial.ac.uk"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "user 2",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "contains": [
            "currentUser = \"naomi-support@imperial.ac.uk\""
          ],
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    }
  ]
}
