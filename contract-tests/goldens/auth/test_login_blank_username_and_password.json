{
  "scenario": "auth/test_login_blank_username_and_password",
  "steps": [
    {
      "client": "A",
      "name": "blank username",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": ""
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/login?username=&error=BadCredentialsException"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "blank password",
      "request": {
        "body": {
          "form": {
            "password": "",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/login?username=test.user%40example.com&error=BadCredentialsException"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "no credentials at all",
      "request": {
        "body": {
          "form": {}
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/login?username=&error=missing_field"
        },
        "status": 303
      }
    }
  ]
}
