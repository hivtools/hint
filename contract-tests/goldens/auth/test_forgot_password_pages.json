{
  "scenario": "auth/test_forgot_password_pages",
  "steps": [
    {
      "client": "A",
      "name": "GET /password/forgot-password",
      "request": {
        "method": "GET",
        "path": "/password/forgot-password"
      },
      "response": {
        "body": {
          "contains": [
            "forgotPasswordApp"
          ],
          "html": true,
          "title": "Naomi: Forgot password"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "reset page shows the token",
      "request": {
        "method": "GET",
        "path": "/password/reset-password",
        "query": {
          "token": "abc"
        }
      },
      "response": {
        "body": {
          "contains": [
            "data-token=\"abc\""
          ],
          "html": true,
          "title": "Naomi: Reset your password"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "reset page without token",
      "request": {
        "method": "GET",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "An unexpected error occurred. If you see this message while you are using Naomi at a workshop, please contact your workshop technical support and show them this code: <ERROR_CODE>. Otherwise please contact support at naomi-support@imperial.ac.uk and quote this code: <ERROR_CODE>. Required request parameter 'token' for method parameter type String is not present",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    }
  ]
}
