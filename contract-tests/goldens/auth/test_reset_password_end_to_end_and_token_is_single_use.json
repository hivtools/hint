{
  "scenario": "auth/test_reset_password_end_to_end_and_token_is_single_use",
  "steps": [
    {
      "client": "A",
      "name": "request link test.user@example.com",
      "request": {
        "body": {
          "form": {
            "email": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/password/request-reset-link"
      },
      "response": {
        "body": {
          "text": "{\"data\":true,\"errors\":[],\"status\":\"success\"}"
        },
        "headers": {
          "content-type": "text/plain"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "reset password",
      "request": {
        "body": {
          "form": {
            "password": "newpassword",
            "token": "<JWT:1>"
          }
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "text": "{\"data\":true,\"errors\":[],\"status\":\"success\"}"
        },
        "headers": {
          "content-type": "text/plain"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "reuse token",
      "request": {
        "body": {
          "form": {
            "password": "another-one",
            "token": "<JWT:1>"
          }
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Token is not valid.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "old password no longer works",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/login?username=test.user%40example.com&error=BadCredentialsException"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "new password works",
      "request": {
        "body": {
          "form": {
            "password": "newpassword",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "authenticated",
      "request": {
        "method": "GET",
        "path": "/projects/"
      },
      "response": {
        "body": {
          "json": {
            "data": [],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "name": "db:onetime_token",
      "rows": [
        {
          "tokens": 0
        }
      ],
      "table": "onetime_token",
      "type": "db"
    }
  ]
}
