{
  "scenario": "auth/test_login_wrong_password",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "badpassword",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/login?username=test.user%40example.com&error=BadCredentialsException"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "still a guest",
      "request": {
        "method": "GET",
        "path": "/projects/"
      },
      "response": {
        "body": {
          "empty": true
        },
        "status": 401
      }
    }
  ]
}
