{
  "scenario": "auth/test_password_endpoints_answer_text_plain_with_a_json_body",
  "steps": [
    {
      "client": "A",
      "name": "request link",
      "request": {
        "body": {
          "form": {
            "email": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/password/request-reset-link"
      },
      "response": {
        "body": {
          "text": "{\"data\":true,\"errors\":[],\"status\":\"success\"}"
        },
        "headers": {
          "content-type": "text/plain"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "reset with bad token",
      "request": {
        "body": {
          "form": {
            "password": "toolong-enough",
            "token": "x"
          }
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Token is not valid.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    }
  ]
}
