      "request": {
        "body": {
          "form": {
            "password": "x",
            "token": "garbage"
          }
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Password must be at least 6 characters long.",
