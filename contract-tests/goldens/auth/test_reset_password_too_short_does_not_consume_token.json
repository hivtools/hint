{
  "scenario": "auth/test_reset_password_too_short_does_not_consume_token",
  "steps": [
    {
      "client": "A",
      "name": "request link test.user@example.com",
      "request": {
        "body": {
          "form": {
            "email": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/password/request-reset-link"
      },
      "response": {
        "body": {
          "text": "{\"data\":true,\"errors\":[],\"status\":\"success\"}"
        },
        "headers": {
          "content-type": "text/plain"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "5 chars",
      "request": {
        "body": {
          "form": {
            "password": "short",
            "token": "<JWT:1>"
          }
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Password must be at least 6 characters long.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "exactly 6 chars",
      "request": {
        "body": {
          "form": {
            "password": "123456",
            "token": "<JWT:1>"
          }
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "text": "{\"data\":true,\"errors\":[],\"status\":\"success\"}"
        },
        "headers": {
          "content-type": "text/plain"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "login with 6 char password",
      "request": {
        "body": {
          "form": {
            "password": "123456",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    }
  ]
}
