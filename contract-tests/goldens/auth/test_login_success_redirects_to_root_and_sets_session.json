{
  "scenario": "auth/test_login_success_redirects_to_root_and_sets_session",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      },
      "session_cookie": "set"
    },
    {
      "client": "A",
      "name": "session now authenticated",
      "request": {
        "method": "GET",
        "path": "/projects/"
      },
      "response": {
        "body": {
          "json": {
            "data": [],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "current project is null before any project",
      "request": {
        "method": "GET",
        "path": "/project/current"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "project": null,
              "version": null
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    }
  ]
}
