{
  "scenario": "auth/test_reset_password_invalid_tokens",
  "steps": [
    {
      "client": "A",
      "name": "garbage token",
      "request": {
        "body": {
          "form": {
            "password": "newpassword",
            "token": "blah"
          }
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Token is not valid.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "well-formed token signed with another key",
      "request": {
        "body": {
          "form": {
            "password": "newpassword",
            "token": "<JWT:1>"
          }
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Token is not valid.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "alg=none token",
      "request": {
        "body": {
          "form": {
            "password": "newpassword",
            "token": "<JWT:2>"
          }
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Token is not valid.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "empty token",
      "request": {
        "body": {
          "form": {
            "password": "newpassword",
            "token": ""
          }
        },
        "method": "POST",
        "path": "/password/reset-password"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Token is not valid.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "password unchanged",
      "request": {
        "body": {
          "form": {
            "password": "newpassword",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/login?username=test.user%40example.com&error=BadCredentialsException"
        },
        "status": 303
      }
    }
  ]
}
