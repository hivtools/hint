{
  "scenario": "pages_and_session/test_json_responses_are_gzipped_when_accepted",
  "steps": [
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "upload shape accept gzip",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "json": {
            "file": {
              "filename": "malawi.geojson",
              "fromADR": false,
              "hash": "EBE533976BFAF0CABCA2C2E1B611B9C7.geojson",
              "path": "<UPLOADS>/EBE533976BFAF0CABCA2C2E1B611B9C7.geojson",
              "resource_url": null
            },
            "type": "shape"
          },
          "method": "POST",
          "path": "/validate/baseline-individual",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "body": {
          "multipart": {
            "file": {
              "filename": "malawi.geojson",
              "fixture": "malawi.geojson",
              "sha256": "fb9a189da2337c0b568998b3ab668ebf9e433e6ec26135cae95c20bf9bd5a953",
              "size": 1045993
            }
          }
        },
        "headers": {
          "accept-encoding": "gzip"
        },
        "method": "POST",
        "path": "/baseline/shape"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-encoding": "gzip",
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "css accept gzip",
      "request": {
        "headers": {
          "accept-encoding": "gzip"
        },
        "method": "GET",
        "path": "/public/css/app.css"
      },
      "response": {
        "body": {
          "ignored": true,
          "non_empty": true
        },
        "headers": {
          "content-encoding": "gzip",
          "content-type": "text/css"
        },
        "status": 200
      }
    }
  ]
}
