{
  "scenario": "sso_mode/test_adr_key_endpoints_still_work_in_sso_mode",
  "steps": [
    {
      "client": "S",
      "name": "start sso login",
      "request": {
        "method": "GET",
        "path": "/oauth2"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "https://<IDP_HOST>/authorize?response_type=code&client_id=fakeId&state=<STATE>&scope=openid+profile+email+access:adr&audience=naomi&redirect_uri=<APP>/callback/oauth2Client"
        },
        "status": 303
      }
    },
    {
      "client": "S",
      "name": "sso callback",
      "outbound": [
        {
          "form": {
            "code": "c",
            "grant_type": "authorization_code",
            "redirect_uri": "<APP>/callback/oauth2Client/oauth2Client"
          },
          "method": "POST",
          "path": "/oauth/token",
          "to": "idp"
        },
        {
          "method": "GET",
          "path": "/userinfo",
          "to": "idp"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/callback/oauth2Client",
        "query": {
          "code": "c",
          "state": "<STATE>"
        }
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 302
      }
    },
    {
      "client": "S",
      "name": "no key",
      "request": {
        "method": "GET",
        "path": "/adr/key"
      },
      "response": {
        "body": {
          "json": {
            "data": null,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "S",
      "name": "save key",
      "request": {
        "body": {
          "form": {
            "key": "k"
          }
        },
        "method": "POST",
        "path": "/adr/key"
      },
      "response": {
        "body": {
          "json": {
            "data": "k",
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "S",
      "name": "key read back",
      "request": {
        "method": "GET",
        "path": "/adr/key"
      },
      "response": {
        "body": {
          "json": {
            "data": "k",
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    }
  ]
}
