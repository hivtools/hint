{
  "scenario": "calibrate/test_calibrate_status_and_results_of_pipeline",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "status",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/calibrate/status/<TASK:calibrate>",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/calibrate/status/<TASK:calibrate>"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
