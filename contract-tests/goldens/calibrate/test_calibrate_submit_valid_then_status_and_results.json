{
  "scenario": "calibrate/test_calibrate_submit_valid_then_status_and_results",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "submit with method proportional",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "json": {
            "iso3": "MWI",
            "options": {
              "calibrate_method": "proportional",
              "spectrum_artnum_calibration_level": "national",
              "spectrum_artnum_calibration_strat": "sex_age_coarse",
              "spectrum_aware_calibration_level": "none",
              "spectrum_aware_calibration_strat": "sex_age_coarse",
              "spectrum_infections_calibration_level": "national",
              "spectrum_infections_calibration_strat": "sex_age_coarse",
              "spectrum_plhiv_calibration_level": "national",
              "spectrum_plhiv_calibration_strat": "sex_age_coarse"
            },
            "version": {
              "hintr": "1.2.23",
              "naomi": "2.10.23",
              "rrq": "0.7.23",
              "traduire": "0.1.1"
            }
          },
          "method": "POST",
          "path": "/calibrate/submit/<TASK:fit>",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "body": {
          "json": {
            "iso3": "MWI",
            "options": {
              "calibrate_method": "proportional",
              "spectrum_artnum_calibration_level": "national",
              "spectrum_artnum_calibration_strat": "sex_age_coarse",
              "spectrum_aware_calibration_level": "none",
              "spectrum_aware_calibration_strat": "sex_age_coarse",
              "spectrum_infections_calibration_level": "national",
              "spectrum_infections_calibration_strat": "sex_age_coarse",
              "spectrum_plhiv_calibration_level": "national",
              "spectrum_plhiv_calibration_strat": "sex_age_coarse"
            },
            "version": {
              "hintr": "1.2.23",
              "naomi": "2.10.23",
              "rrq": "0.7.23",
              "traduire": "0.1.1"
            }
          }
        },
        "method": "POST",
        "path": "/calibrate/submit/<TASK:fit>"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "status until done",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/calibrate/status/<TASK:fresh>",
          "status": 200,
          "to": "hintr"
        }
      ],
      "poll": {
        "until": "data.done == true"
      },
      "request": {
        "method": "GET",
        "path": "/calibrate/status/<TASK:fresh>"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "metadata",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/calibrate/result/metadata/<TASK:fresh>",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/calibrate/result/metadata/<TASK:fresh>"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "plot",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/calibrate/plot/<TASK:fresh>",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/calibrate/plot/<TASK:fresh>"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    }
  ]
}
