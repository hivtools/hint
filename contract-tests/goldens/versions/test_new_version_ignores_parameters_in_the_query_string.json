{
  "scenario": "versions/test_new_version_ignores_parameters_in_the_query_string",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "create project P",
      "request": {
        "body": {
          "json": {
            "name": "P",
            "note": "pnote"
          }
        },
        "method": "POST",
        "path": "/project"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "id": "<PROJECT:1>",
              "name": "P",
              "note": null,
              "sharedBy": "",
              "uploaded": null,
              "versions": [
                {
                  "created": "<TIMESTAMP>",
                  "id": "<UUID:1>",
                  "note": null,
                  "updated": "<TIMESTAMP>",
                  "versionNumber": 1
                }
              ]
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "save state",
      "request": {
        "body": {
          "raw": {
            "content_type": "application/json",
            "sha256": "46b45ac04f7ff7b965179f8d21a89d0db7ef0316011bdf5f4448140108465371",
            "size": 55
          }
        },
        "method": "POST",
        "path": "/project/<PROJECT:1>/version/<UUID:1>/state"
      },
      "response": {
        "body": {
          "json": {
            "data": true,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "query string only",
      "request": {
        "method": "POST",
        "path": "/project/<PROJECT:1>/version",
        "query": {
          "note": "from query",
          "parent": "<UUID:1>"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "An unexpected error occurred. If you see this message while you are using Naomi at a workshop, please contact your workshop technical support and show them this code: <ERROR_CODE>. Otherwise please contact support at naomi-support@imperial.ac.uk and quote this code: <ERROR_CODE>. Required request body is missing: public org.springframework.http.ResponseEntity<java.lang.String> org.imperial.mrc.hint.controllers.ProjectsController.newVersion(int,org.imperial.mrc.hint.models.NewVersionRequest)",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "note in the query",
      "request": {
        "body": {
          "json": {
            "parent": "<UUID:1>"
          }
        },
        "method": "POST",
        "path": "/project/<PROJECT:1>/version",
        "query": {
          "note": "from query"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "created": "<TIMESTAMP>",
              "id": "<UUID:2>",
              "note": null,
              "updated": "<TIMESTAMP>",
              "versionNumber": 2
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "form body is not accepted",
      "request": {
        "body": {
          "form": {
            "parent": "<UUID:1>"
          }
        },
        "method": "POST",
        "path": "/project/<PROJECT:1>/version"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "An unexpected error occurred. If you see this message while you are using Naomi at a workshop, please contact your workshop technical support and show them this code: <ERROR_CODE>. Otherwise please contact support at naomi-support@imperial.ac.uk and quote this code: <ERROR_CODE>. Content type 'application/x-www-form-urlencoded;charset=UTF-8' not supported",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 415
      }
    }
  ]
}
