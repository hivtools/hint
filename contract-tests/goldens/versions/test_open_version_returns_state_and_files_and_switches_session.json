{
  "scenario": "versions/test_open_version_returns_state_and_files_and_switches_session",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "create project P",
      "request": {
        "body": {
          "json": {
            "name": "P",
            "note": "pnote"
          }
        },
        "method": "POST",
        "path": "/project"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "id": "<PROJECT:1>",
              "name": "P",
              "note": null,
              "sharedBy": "",
              "uploaded": null,
              "versions": [
                {
                  "created": "<TIMESTAMP>",
                  "id": "<UUID:1>",
                  "note": null,
                  "updated": "<TIMESTAMP>",
                  "versionNumber": 1
                }
              ]
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "upload pjnz",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "json": {
            "file": {
              "filename": "Malawi2024.PJNZ",
              "fromADR": false,
              "hash": "46E4A725064B0E287F573A8F11389895.PJNZ",
              "path": "<UPLOADS>/46E4A725064B0E287F573A8F11389895.PJNZ",
              "resource_url": null
            },
            "type": "pjnz"
          },
          "method": "POST",
          "path": "/validate/baseline-individual",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "body": {
          "multipart": {
            "file": {
              "filename": "Malawi2024.PJNZ",
              "fixture": "Malawi2024.PJNZ",
              "sha256": "49d688e8fe81c4d4dd49a081791e756bcdbbd1542587812bceea354bda02d3c1",
              "size": 1721376
            }
          }
        },
        "method": "POST",
        "path": "/baseline/pjnz/"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "save state",
      "request": {
        "body": {
          "raw": {
            "content_type": "application/json",
            "sha256": "46b45ac04f7ff7b965179f8d21a89d0db7ef0316011bdf5f4448140108465371",
            "size": 55
          }
        },
        "method": "POST",
        "path": "/project/<PROJECT:1>/version/<UUID:1>/state"
      },
      "response": {
        "body": {
          "json": {
            "data": true,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "v2",
      "request": {
        "body": {
          "json": {
            "parent": "<UUID:1>"
          }
        },
        "method": "POST",
        "path": "/project/<PROJECT:1>/version"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "created": "<TIMESTAMP>",
              "id": "<UUID:2>",
              "note": null,
              "updated": "<TIMESTAMP>",
              "versionNumber": 2
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "remove file from v2 (the current session version)",
      "request": {
        "method": "DELETE",
        "path": "/baseline/pjnz/"
      },
      "response": {
        "body": {
          "json": {
            "data": true,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "v2 has no file",
      "request": {
        "method": "GET",
        "path": "/baseline/pjnz/"
      },
      "response": {
        "body": {
          "json": {
            "data": null,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "open v1",
      "request": {
        "method": "GET",
        "path": "/project/<PROJECT:1>/version/<UUID:1>"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "files": {
                "pjnz": {
                  "filename": "Malawi2024.PJNZ",
                  "fromAdr": false,
                  "hash": "46E4A725064B0E287F573A8F11389895.PJNZ",
                  "resource_url": null
                }
              },
              "state": "{\"datasets\": {}, \"model_fit\": {\"id\": \"abc\"}, \"step\": 3}"
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "session now shows v1's file",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "json": {
            "file": {
              "filename": "Malawi2024.PJNZ",
              "fromADR": false,
              "hash": "46E4A725064B0E287F573A8F11389895.PJNZ",
              "path": "<UPLOADS>/46E4A725064B0E287F573A8F11389895.PJNZ",
              "resource_url": null
            },
            "type": "pjnz"
          },
          "method": "POST",
          "path": "/validate/baseline-individual",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/baseline/pjnz/"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "current is v1",
      "request": {
        "method": "GET",
        "path": "/project/current"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "project": {
                "id": "<PROJECT:1>",
                "name": "P",
                "note": "pnote",
                "sharedBy": null,
                "uploaded": null,
                "versions": [
                  {
                    "created": "<TIMESTAMP>",
                    "id": "<UUID:1>",
                    "note": null,
                    "updated": "<TIMESTAMP>",
                    "versionNumber": 1
                  },
                  {
                    "created": "<TIMESTAMP>",
                    "id": "<UUID:2>",
                    "note": null,
                    "updated": "<TIMESTAMP>",
                    "versionNumber": 2
                  }
                ]
              },
              "version": {
                "created": "<TIMESTAMP>",
                "id": "<UUID:1>",
                "note": null,
                "updated": "<TIMESTAMP>",
                "versionNumber": 1
              }
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    }
  ]
}
