{
  "scenario": "sso/test_sso_state_errors",
  "steps": [
    {
      "client": "A",
      "name": "start sso login",
      "request": {
        "method": "GET",
        "path": "/oauth2"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "https://<IDP_HOST>/authorize?response_type=code&client_id=fakeId&state=<STATE>&scope=openid+profile+email+access:adr&audience=naomi&redirect_uri=<APP>/callback/oauth2Client"
        },
        "status": 303
      },
      "session_cookie": "set"
    },
    {
      "client": "A",
      "name": "state mismatch",
      "request": {
        "method": "GET",
        "path": "/callback/oauth2Client",
        "query": {
          "code": "the-code",
          "state": "wrong-state"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Auth0 State parameter mismatch possible threat of cross-site request forgery",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "state missing",
      "request": {
        "method": "GET",
        "path": "/callback/oauth2Client",
        "query": {
          "code": "the-code"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Auth0 state parameter must be provided",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "no parameters at all",
      "request": {
        "method": "GET",
        "path": "/callback/oauth2Client"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Auth0 state parameter must be provided",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "state but no code",
      "request": {
        "method": "GET",
        "path": "/callback/oauth2Client",
        "query": {
          "state": "<STATE>"
        }
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 302
      }
    },
    {
      "client": "B",
      "name": "correct state but in a different session",
      "request": {
        "method": "GET",
        "path": "/callback/oauth2Client",
        "query": {
          "code": "the-code",
          "state": "<STATE>"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Auth0 State parameter mismatch possible threat of cross-site request forgery",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "name": "db:users",
      "rows": [
        {
          "id": "guest",
          "username": "guest"
        },
        {
          "id": "naomi-support@imperial.ac.uk",
          "username": "naomi-support@imperial.ac.uk"
        },
        {
          "id": "test.user@example.com",
          "username": "test.user@example.com"
        }
      ],
      "table": "users",
      "type": "db"
    }
  ]
}
