{
  "scenario": "sso/test_sso_state_is_single_use_per_login_start",
  "steps": [
    {
      "client": "A",
      "name": "start sso login",
      "request": {
        "method": "GET",
        "path": "/oauth2"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "https://<IDP_HOST>/authorize?response_type=code&client_id=fakeId&state=<STATE>&scope=openid+profile+email+access:adr&audience=naomi&redirect_uri=<APP>/callback/oauth2Client"
        },
        "status": 303
      },
      "session_cookie": "set"
    },
    {
      "client": "A",
      "name": "start sso login",
      "request": {
        "method": "GET",
        "path": "/oauth2"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "https://<IDP_HOST>/authorize?response_type=code&client_id=fakeId&state=<STATE>&scope=openid+profile+email+access:adr&audience=naomi&redirect_uri=<APP>/callback/oauth2Client"
        },
        "status": 303
      },
      "session_cookie": "set"
    },
    {
      "client": "A",
      "name": "state of the first start is superseded",
      "request": {
        "method": "GET",
        "path": "/callback/oauth2Client",
        "query": {
          "code": "the-code",
          "state": "<STATE>"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Auth0 State parameter mismatch possible threat of cross-site request forgery",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "latest state works",
      "outbound": [
        {
          "form": {
            "code": "the-code",
            "grant_type": "authorization_code",
            "redirect_uri": "<APP>/callback/oauth2Client/oauth2Client"
          },
          "method": "POST",
          "path": "/oauth/token",
          "to": "idp"
        },
        {
          "method": "GET",
          "path": "/userinfo",
          "to": "idp"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/callback/oauth2Client",
        "query": {
          "code": "the-code",
          "state": "<STATE>"
        }
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 302
      }
    }
  ]
}
