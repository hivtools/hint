{
  "scenario": "adr_push/test_push_without_key_and_as_guest",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "no key",
      "request": {
        "method": "POST",
        "path": "/adr/datasets/ds1/resource/inputs-unaids-spectrum-file/x",
        "query": {
          "resourceFileName": "f",
          "resourceId": "r",
          "resourceName": "n"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "File does not exist",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "G",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "G",
      "name": "guest",
      "request": {
        "method": "POST",
        "path": "/adr/datasets/ds1/resource/inputs-unaids-spectrum-file/x",
        "query": {
          "resourceFileName": "f",
          "resourceId": "r",
          "resourceName": "n"
        }
      },
      "response": {
        "body": {
          "json": {
            "error": "Unauthorized",
            "path": "/adr/datasets/ds1/resource/inputs-unaids-spectrum-file/x",
            "status": 401,
            "timestamp": "<EPOCH_MS>"
          }
        },
        "headers": {
          "content-type": "application/json",
          "www-authenticate": "Bearer realm=\"pac4j\""
        },
        "status": 401
      }
    }
  ]
}
