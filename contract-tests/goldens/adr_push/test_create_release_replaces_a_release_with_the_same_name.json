{
  "scenario": "adr_push/test_create_release_replaces_a_release_with_the_same_name",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "existing v1 is deleted first",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/dataset_version_list",
          "query": {
            "dataset_id": "ds1"
          },
          "to": "adr"
        },
        {
          "form": {
            "version_id": "old-1"
          },
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "POST",
          "path": "/api/3/action/version_delete",
          "to": "adr"
        },
        {
          "form": {
            "dataset_id": "ds1",
            "name": "v1"
          },
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "POST",
          "path": "/api/3/action/dataset_version_create",
          "to": "adr"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/adr/datasets/ds1/releases",
        "query": {
          "name": "v1"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "dataset_id": "ds1",
              "id": "new-release-id",
              "name": "v1"
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "no duplicate",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/dataset_version_list",
          "query": {
            "dataset_id": "ds1"
          },
          "to": "adr"
        },
        {
          "form": {
            "dataset_id": "ds1",
            "name": "v3"
          },
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "POST",
          "path": "/api/3/action/dataset_version_create",
          "to": "adr"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/adr/datasets/ds1/releases",
        "query": {
          "name": "v3"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "dataset_id": "ds1",
              "id": "new-release-id",
              "name": "v3"
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "french header does not matter",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/dataset_version_list",
          "query": {
            "dataset_id": "ds1"
          },
          "to": "adr"
        },
        {
          "form": {
            "version_id": "old-1"
          },
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "POST",
          "path": "/api/3/action/version_delete",
          "to": "adr"
        },
        {
          "form": {
            "dataset_id": "ds1",
            "name": "v1"
          },
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "POST",
          "path": "/api/3/action/dataset_version_create",
          "to": "adr"
        }
      ],
      "request": {
        "headers": {
          "accept-language": "fr"
        },
        "method": "POST",
        "path": "/adr/datasets/ds1/releases",
        "query": {
          "name": "v1"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "dataset_id": "ds1",
              "id": "new-release-id",
              "name": "v1"
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    }
  ]
}
