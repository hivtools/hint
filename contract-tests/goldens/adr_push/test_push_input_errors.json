{
  "scenario": "adr_push/test_push_input_errors",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "file not in session",
      "request": {
        "method": "POST",
        "path": "/adr/datasets/ds1/resource/inputs-unaids-spectrum-file/x",
        "query": {
          "resourceFileName": "f",
          "resourceId": "res-in",
          "resourceName": "n"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "File does not exist",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "resourceId missing for an input type",
      "request": {
        "method": "POST",
        "path": "/adr/datasets/ds1/resource/inputs-unaids-spectrum-file/x",
        "query": {
          "resourceFileName": "f",
          "resourceName": "n"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "resourceId must be provided for input resourceType",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "resource unknown to the adr (resource_show 404)",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/resource_show",
          "query": {
            "id": "res-in"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/adr/datasets/ds1/resource/inputs-unaids-spectrum-file/x",
        "query": {
          "resourceFileName": "f",
          "resourceId": "res-in",
          "resourceName": "n"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Unable to retrieve hash from ADR",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 500
      }
    },
    {
      "client": "A",
      "name": "resource_patch fails",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/resource_show",
          "query": {
            "id": "res-in"
          },
          "to": "adr"
        },
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "POST",
          "multipart": {
            "fields": {
              "hash": "46E4A725064B0E287F573A8F11389895",
              "id": "res-in",
              "name": "n",
              "resource_type": "inputs-unaids-spectrum-file"
            },
            "files": {
              "upload": {
                "filename": "Malawi2024.PJNZ",
                "md5": "46e4a725064b0e287f573a8f11389895",
                "size": 1721376
              }
            }
          },
          "path": "/api/3/action/resource_patch",
          "to": "adr"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/adr/datasets/ds1/resource/inputs-unaids-spectrum-file/x",
        "query": {
          "resourceFileName": "f",
          "resourceId": "res-in",
          "resourceName": "n"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "patch failed",
                "error": "ADR_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 500
      }
    },
    {
      "client": "A",
      "name": "resourceName missing",
      "request": {
        "method": "POST",
        "path": "/adr/datasets/ds1/resource/inputs-unaids-spectrum-file/x",
        "query": {
          "resourceFileName": "f",
          "resourceId": "res-in"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "An unexpected error occurred. If you see this message while you are using Naomi at a workshop, please contact your workshop technical support and show them this code: <ERROR_CODE>. Otherwise please contact support at naomi-support@imperial.ac.uk and quote this code: <ERROR_CODE>. Required request parameter 'resourceName' for method parameter type String is not present",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    }
  ]
}
