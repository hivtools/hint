    },
    {
      "client": "A",
      "name": "description missing",
      "request": {
        "method": "POST",
        "path": "/adr/datasets/ds1/resource/inputs-unaids-naomi-output-zip/<TASK:download-spectrum>",
        "query": {
          "resourceFileName": "o.zip",
          "resourceName": "n"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "description must be provided for output resourceType",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
