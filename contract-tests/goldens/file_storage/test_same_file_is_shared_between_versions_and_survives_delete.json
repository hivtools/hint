{
  "scenario": "file_storage/test_same_file_is_shared_between_versions_and_survives_delete",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "create project p",
      "request": {
        "body": {
          "json": {
            "name": "p",
            "note": "a note"
          }
        },
        "method": "POST",
        "path": "/project"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "id": "<PROJECT:1>",
              "name": "p",
              "note": null,
              "sharedBy": "",
              "uploaded": null,
              "versions": [
                {
                  "created": "<TIMESTAMP>",
                  "id": "<UUID:1>",
                  "note": null,
                  "updated": "<TIMESTAMP>",
                  "versionNumber": 1
                }
              ]
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "upload pjnz",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "json": {
            "file": {
              "filename": "Malawi2024.PJNZ",
              "fromADR": false,
              "hash": "46E4A725064B0E287F573A8F11389895.PJNZ",
              "path": "<UPLOADS>/46E4A725064B0E287F573A8F11389895.PJNZ",
              "resource_url": null
            },
            "type": "pjnz"
          },
          "method": "POST",
          "path": "/validate/baseline-individual",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "body": {
          "multipart": {
            "file": {
              "filename": "Malawi2024.PJNZ",
              "fixture": "Malawi2024.PJNZ",
              "sha256": "49d688e8fe81c4d4dd49a081791e756bcdbbd1542587812bceea354bda02d3c1",
              "size": 1721376
            }
          }
        },
        "method": "POST",
        "path": "/baseline/pjnz/"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "v2 copies file refs",
      "request": {
        "body": {
          "json": {
            "parent": "<UUID:1>"
          }
        },
        "method": "POST",
        "path": "/project/<PROJECT:1>/version"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "created": "<TIMESTAMP>",
              "id": "<UUID:2>",
              "note": null,
              "updated": "<TIMESTAMP>",
              "versionNumber": 2
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "remove from v2",
      "request": {
        "method": "DELETE",
        "path": "/baseline/pjnz/"
      },
      "response": {
        "body": {
          "json": {
            "data": true,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "name": "db:version_file",
      "rows": [
        {
          "filename": "Malawi2024.PJNZ",
          "from_adr": false,
          "hash": "46E4A725064B0E287F573A8F11389895.PJNZ",
          "resource_url": null,
          "type": "pjnz",
          "version": "<UUID:1>"
        }
      ],
      "table": "version_file",
      "type": "db"
    },
    {
      "name": "db:file",
      "rows": [
        {
          "hash": "46E4A725064B0E287F573A8F11389895.PJNZ"
        }
      ],
      "table": "file",
      "type": "db"
    },
    {
      "files": [
        {
          "name": "46E4A725064B0E287F573A8F11389895.PJNZ",
          "name_matches_md5": true,
          "size": 1721376
        }
      ],
      "name": "uploads",
      "type": "uploads"
    },
    {
      "client": "A",
      "name": "state",
      "request": {
        "body": {
          "raw": {
            "content_type": "application/json",
            "sha256": "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a",
            "size": 2
          }
        },
        "method": "POST",
        "path": "/project/<PROJECT:1>/version/<UUID:2>/state"
      },
      "response": {
        "body": {
          "json": {
            "data": true,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "v1 still has the file",
      "request": {
        "method": "GET",
        "path": "/project/<PROJECT:1>/version/<UUID:1>"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "An unexpected error occurred. If you see this message while you are using Naomi at a workshop, please contact your workshop technical support and show them this code: <ERROR_CODE>. Otherwise please contact support at naomi-support@imperial.ac.uk and quote this code: <ERROR_CODE>.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 500
      }
    },
    {
      "client": "A",
      "name": "so the session (now v1) validates it",
      "request": {
        "method": "GET",
        "path": "/baseline/pjnz/"
      },
      "response": {
        "body": {
          "json": {
            "data": null,
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    }
  ]
}
