    {
      "client": "A",
      "name": "connection closed without a response",
      "outbound": [
        {
          "fault": "close",
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/hintr/version",
          "status": null,
          "to": "hintr"
        },
        {
          "fault": "close",
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/hintr/version",
          "status": null,
          "to": "hintr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/meta/hintr/version"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "No response returned. The request may have timed out.",
