{
  "scenario": "version_header/test_without_the_header_the_version_in_the_session_is_used",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "create project p",
      "request": {
        "body": {
          "json": {
            "name": "p",
            "note": "a note"
          }
        },
        "method": "POST",
        "path": "/project"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "id": "<PROJECT:1>",
              "name": "p",
              "note": null,
              "sharedBy": "",
