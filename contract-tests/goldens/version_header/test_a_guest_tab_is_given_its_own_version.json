{
  "scenario": "version_header/test_a_guest_tab_is_given_its_own_version",
  "steps": [
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "the guest tab asks for a version",
      "request": {
        "method": "POST",
        "path": "/guest/version"
      },
      "response": {
        "body": {
          "json": {
            "data": {
              "created": "<TIMESTAMP>",
              "id": "<UUID:1>",
              "note": null,
              "updated": "<TIMESTAMP>",
              "versionNumber": 1
            },
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "upload pjnz",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "json": {
            "file": {
