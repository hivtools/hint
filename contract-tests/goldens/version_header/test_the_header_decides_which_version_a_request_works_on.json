        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "upload with the first version in the header",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "json": {
            "file": {
              "filename": "Malawi2024.PJNZ",
              "fromADR": false,
              "hash": "46E4A725064B0E287F573A8F11389895.PJNZ",
              "path": "<UPLOADS>/46E4A725064B0E287F573A8F11389895.PJNZ",
              "resource_url": null
            },
            "type": "pjnz"
          },
          "method": "POST",
          "path": "/validate/baseline-individual",
          "status": 200,
          "to": "hintr"
