{
  "scenario": "version_header/test_a_logged_in_user_cannot_get_a_guest_version",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "logged in user asks for a guest version",
      "request": {
        "method": "POST",
        "path": "/guest/version"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Only guests can create a guest version.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 403
      }
    },
    {
      "client": "A",
      "name": "in french",
      "request": {
        "headers": {
          "accept-language": "fr"
        },
        "method": "POST",
        "path": "/guest/version"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "Seuls les invités peuvent créer une version d'invité.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 403
      }
    }
  ]
}
