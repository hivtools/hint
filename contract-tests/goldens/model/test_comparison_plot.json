{
  "scenario": "model/test_comparison_plot",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "comparison plot of calibration",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/comparison/plot/<TASK:calibrate>",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/model/comparison/plot/<TASK:calibrate>"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "comparison plot of failed calibration",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/comparison/plot/<TASK:calibrate-error>",
          "status": 400,
          "to": "hintr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/model/comparison/plot/<TASK:calibrate-error>"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "comparison plot of failed fit",
      "outbound": [
        {
          "headers": {
            "accept-language": "en"
          },
          "method": "GET",
          "path": "/comparison/plot/<TASK:fit-error>",
          "status": 400,
          "to": "hintr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/model/comparison/plot/<TASK:fit-error>"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "in french",
      "outbound": [
        {
          "headers": {
            "accept-language": "fr"
          },
          "method": "GET",
          "path": "/comparison/plot/<TASK:calibrate>",
          "status": 200,
          "to": "hintr"
        }
      ],
      "request": {
        "headers": {
          "accept-language": "fr"
        },
        "method": "GET",
        "path": "/model/comparison/plot/<TASK:calibrate>"
      },
      "response": {
        "body": {
          "same_as_upstream": "hintr"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    }
  ]
}
