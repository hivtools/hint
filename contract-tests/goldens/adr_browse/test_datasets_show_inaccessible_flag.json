                    "resource_type": "inputs-unaids-naomi-report",
                    "url": "http://adr.example/r4"
                  }
                ],
                "title": "Dataset d-output-1",
                "type": "country-estimates-26"
              },
              {
                "id": "d-no-zip",
                "name": "d-no-zip",
                "resources": [
                  {
                    "id": "r6",
