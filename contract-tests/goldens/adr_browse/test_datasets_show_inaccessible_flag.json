                    "url": "http://adr.example/r1"
                  },
                  {
                    "id": "r2",
                    "name": "r2",
                    "resource_type": "inputs-unaids-geographic",
                    "url": "http://adr.example/r2"
                  }
                ],
                "title": "Dataset d-input-1",
                "type": "country-estimates-26"
              },
              {
                "id": "d-output-1",
