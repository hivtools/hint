{
  "scenario": "adr_browse/test_datasets_show_inaccessible_flag",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "showInaccessible=true",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/package_search",
          "query": {
            "include_private": "true",
            "q": "type:(country-estimates-26)",
            "rows": "1000"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/datasets",
        "query": {
          "showInaccessible": "true",
          "type": "input"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": [
              {
                "id": "d-input-1",
                "name": "d-input-1",
                "resources": [
                  {
                    "id": "r1",
                    "name": "r1",
