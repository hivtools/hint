                    "resource_type": "inputs-unaids-naomi-report",
                    "url": "http://adr.example/r6"
                  }
                ],
                "title": "Dataset d-no-zip",
                "type": "country-estimates-26"
              }
            ],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "showInaccessible=false",
