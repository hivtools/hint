{
  "scenario": "adr_browse/test_datasets_output_filter_and_query",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "output datasets (this year and last year)",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/package_search",
          "query": {
            "hide_inaccessible_resources": "true",
            "include_private": "true",
            "q": "type:(country-estimates-26 OR country-estimates-25)",
            "rows": "1000"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/datasets",
        "query": {
          "type": "output"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": [
              {
                "id": "d-output-1",
                "name": "d-output-1",
                "resources": [
                  {
                    "id": "r3",
                    "name": "r3",
                    "resource_type": "inputs-unaids-naomi-output-zip",
                    "url": "http://adr.example/r3"
                  },
                  {
                    "id": "r4",
                    "name": "r4",
                    "resource_type": "inputs-unaids-naomi-report",
                    "url": "http://adr.example/r4"
                  }
                ],
                "title": "Dataset d-output-1",
                "type": "country-estimates-26"
              },
              {
                "id": "d-output-old",
                "name": "d-output-old",
                "resources": [
                  {
                    "id": "r5",
                    "name": "r5",
                    "resource_type": "inputs-unaids-naomi-output-zip",
                    "url": "http://adr.example/r5"
                  }
                ],
                "title": "Dataset d-output-old",
                "type": "country-estimates-25"
              }
            ],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    }
  ]
}
