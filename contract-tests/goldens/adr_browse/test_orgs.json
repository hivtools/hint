{
  "scenario": "adr_browse/test_orgs",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "orgs",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/organization_list_for_user",
          "query": {
            "permission": "create_dataset"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/orgs",
        "query": {
          "permission": "create_dataset"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": [
              {
                "id": "org-1",
                "name": "unaids"
              },
              {
                "id": "org-2",
                "name": "ministry"
              }
            ],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "permission missing",
      "request": {
        "method": "GET",
        "path": "/adr/orgs"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "An unexpected error occurred. If you see this message while you are using Naomi at a workshop, please contact your workshop technical support and show them this code: <ERROR_CODE>. Otherwise please contact support at naomi-support@imperial.ac.uk and quote this code: <ERROR_CODE>. Required request parameter 'permission' for method parameter type String is not present",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 400
      }
    },
    {
      "client": "A",
      "name": "adr failure",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/organization_list_for_user",
          "query": {
            "permission": "read"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/orgs",
        "query": {
          "permission": "read"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "boom",
                "error": "ADR_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 500
      }
    }
  ]
}
