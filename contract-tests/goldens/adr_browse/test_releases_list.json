{
  "scenario": "adr_browse/test_releases_list",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "all releases",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/dataset_version_list",
          "query": {
            "dataset_id": "d-output-1"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/datasets/d-output-1/releases"
      },
      "response": {
        "body": {
          "json": {
            "data": [
              {
                "id": "rel-1",
                "name": "v1"
              },
              {
                "id": "rel-2",
                "name": "v2"
              }
            ],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "dataset without releases",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/dataset_version_list",
          "query": {
            "dataset_id": "d-input-1"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/datasets/d-input-1/releases"
      },
      "response": {
        "body": {
          "json": {
            "data": [],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "output type keeps releases with a zip",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/dataset_version_list",
          "query": {
            "dataset_id": "d-output-1"
          },
          "to": "adr"
        },
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/package_show",
          "query": {
            "id": "d-output-1",
            "release": "rel-1"
          },
          "to": "adr"
        },
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/package_show",
          "query": {
            "id": "d-output-1",
            "release": "rel-2"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/datasets/d-output-1/releases",
        "query": {
          "type": "output"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": [
              {
                "id": "rel-1",
                "name": "v1"
              }
            ],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "other type value is not filtered",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/dataset_version_list",
          "query": {
            "dataset_id": "d-output-1"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/datasets/d-output-1/releases",
        "query": {
          "type": "input"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": [
              {
                "id": "rel-1",
                "name": "v1"
              },
              {
                "id": "rel-2",
                "name": "v2"
              }
            ],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    }
  ]
}
