{
  "scenario": "adr_browse/test_releases_adr_failures",
  "steps": [
    {
      "client": "A",
      "name": "login test.user@example.com",
      "request": {
        "body": {
          "form": {
            "password": "password",
            "username": "test.user@example.com"
          }
        },
        "method": "POST",
        "path": "/callback/formClient"
      },
      "response": {
        "body": {
          "empty": true
        },
        "headers": {
          "location": "/"
        },
        "status": 303
      }
    },
    {
      "client": "A",
      "name": "open /",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "response": {
        "body": {
          "html": true,
          "title": "Naomi"
        },
        "headers": {
          "content-type": "text/html"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "list fails",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/dataset_version_list",
          "query": {
            "dataset_id": "d-output-1"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/datasets/d-output-1/releases"
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "boom",
                "error": "ADR_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 500
      }
    },
    {
      "client": "A",
      "name": "list fails, type=output",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/dataset_version_list",
          "query": {
            "dataset_id": "d-output-1"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/datasets/d-output-1/releases",
        "query": {
          "type": "output"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": [],
            "errors": [],
            "status": "success"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 200
      }
    },
    {
      "client": "A",
      "name": "package_show of a release fails",
      "outbound": [
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/dataset_version_list",
          "query": {
            "dataset_id": "d-output-1"
          },
          "to": "adr"
        },
        {
          "headers": {
            "authorization": "<UUID:1>"
          },
          "method": "GET",
          "path": "/api/3/action/package_show",
          "query": {
            "id": "d-output-1",
            "release": "rel-1"
          },
          "to": "adr"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/adr/datasets/d-output-1/releases",
        "query": {
          "type": "output"
        }
      },
      "response": {
        "body": {
          "json": {
            "data": {},
            "errors": [
              {
                "detail": "An unexpected error occurred. If you see this message while you are using Naomi at a workshop, please contact your workshop technical support and show them this code: <ERROR_CODE>. Otherwise please contact support at naomi-support@imperial.ac.uk and quote this code: <ERROR_CODE>.",
                "error": "OTHER_ERROR"
              }
            ],
            "status": "failure"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 500
      }
    }
  ]
}
